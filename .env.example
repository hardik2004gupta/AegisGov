# AegisGov Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=aegisgov
POSTGRES_USER=aegisgov
POSTGRES_PASSWORD=change-me-in-development

# Full async URL used by SQLAlchemy inside the backend container
DATABASE_URL=postgresql+asyncpg://aegisgov:change-me-in-development@postgres:5432/aegisgov

# ─── OPA ──────────────────────────────────────────────────────────────────────
OPA_URL=http://opa:8181
OPA_POLICY_PATH=v1/data/aegis

# ─── Keycloak ─────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-development

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=aegisgov
KEYCLOAK_CLIENT_ID=aegisgov-backend
KEYCLOAK_CLIENT_SECRET=dev-backend-secret

# ─── Agent Identity ────────────────────────────────────────────────────────────
# Secret used to sign internal workload JWTs (Phase 2).
# MUST be changed for any non-local deployment.
AGENT_JWT_SECRET=dev-agent-secret-change-in-production
AGENT_JWT_ALGORITHM=HS256

# ─── LLM (Phase 2+) ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-placeholder
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# ─── Langfuse Observability (Phase 4+) ────────────────────────────────────────
# Leave empty to disable Langfuse; PostgreSQL audit always runs.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# ─── Runtime Governance Limits ────────────────────────────────────────────────
MAX_TOOL_CALLS=8
MAX_EXECUTION_TIME_SECONDS=60
MAX_AGENT_HANDOFFS=4
MAX_IDENTICAL_TOOL_CALLS=3

# ─── Frontend (passed via docker-compose environment) ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=aegisgov
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=aegisgov-frontend
